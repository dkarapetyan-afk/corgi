# Several workspaces: create, switch, open the editor and chooser, hover.
key ctrl+b 'N'
type alpha
waittext "hold to create"
holdclicktext "hold to create" 3200
settle
snap alpha
key ctrl+b 'N'
type beta
waittext "hold to create"
holdclicktext "hold to create" 3200
settle
snap beta
key ctrl+b {
settle
snap prev-ws
key ctrl+b }
settle
snap next-ws
key ctrl+b 'W'
settle
snap edit-ws
key esc
key ctrl+b w
settle
snap choose
key esc
settle
clicktext project
settle
snap clicked-ws
hovertext alpha
wait 300
snap hover-ws
move 60 25
