# Close panes and tabs, reopen a closed agent, break, swap and resize.
key ctrl+b c
key t
settle
type echo first
key enter
key ctrl+b v
settle
type claude
key enter
waittext ›
settle
snap split
key ctrl+b x
settle
snap closed-pane
key ctrl+b u
waittext ›
settle
snap reopened-agent
key ctrl+b v
settle
snap before-break
key ctrl+b !
settle
snap broken-out
key ctrl+b X
settle
snap tab-closed
key ctrl+b c
key t
settle
type echo upper
key enter
key ctrl+b -
settle
type echo lower
key enter
settle
snap before-swap
key ctrl+b 'K'
settle
snap swapped
key ctrl+b r
snap resize-mode
key j j
snap resized
key esc
snap resize-done
